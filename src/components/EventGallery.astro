---
interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<h1 class="page-title">{title}</h1>

<div class="photo-placeholder">
  Fotos folgen &mdash; hier kommen die Bilder rein, sobald sie vom Verein bereitgestellt werden.
</div>

<p><a href={`${base}bilder/2014/`}>&larr; Zurück zu Bilder 2014</a></p>
