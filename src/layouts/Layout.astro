---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Burschenverein Pliening e.V. — Verein für Brauchtum und Tradition in Pliening.' } = Astro.props;

const base = import.meta.env.BASE_URL;

const navItems = [
  { href: base, label: 'Startseite' },
  { href: `${base}zu-verleihen/`, label: 'Zu Verleihen' },
  { href: `${base}vorstandschaft/`, label: 'Die Vorstandschaft' },
  { href: `${base}bilder/`, label: 'Bilder & Mehr' },
  { href: `${base}links/`, label: 'Links' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Burschenverein Pliening e.V.</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="site-title" href={base}>Burschenverein Pliening e.V.</a>
        <nav class="site-nav" aria-label="Hauptnavigation">
          {navItems.map((item) => (
            <a
              href={item.href}
              aria-current={currentPath === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <div class="rauten-strip"></div>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <div class="rauten-strip"></div>
    <footer class="site-footer">
      <div class="wrap">
        <div>
          1. Vorstand: Benno Burghart &middot; Melchior-Huber-Straße 20a, 85652 Pliening<br />
          E-Mail: <a href="mailto:burschenverein.pliening@gmx.de">burschenverein.pliening@gmx.de</a>
          &middot; Tel.: <a href="tel:+4915231882053">+49 152 31882053</a>
        </div>
        <div class="footer-links">
          <a href="https://www.instagram.com/burschenverein_pliening" target="_blank" rel="noopener">Instagram</a>
          <a href={`${base}impressum/`}>Impressum & Datenschutz</a>
        </div>
      </div>
    </footer>
  </body>
</html>
