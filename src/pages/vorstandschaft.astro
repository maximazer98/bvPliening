---
import Layout from '../layouts/Layout.astro';

const vorstand = [
  { position: '1. Vorstand', name: 'Benno Burghart' },
  { position: '2. Vorstand', name: 'Tobias Noack' },
  { position: '3. Vorstand', name: 'Florian Lipp' },
  { position: '1. Kassier', name: 'Tobias Scheungraber' },
  { position: '2. Kassier', name: 'Xaver Burghart' },
  { position: '1. Schriftführer', name: 'Marvin Ziegler' },
  { position: '2. Schriftführer', name: 'Martin Weilhammer' },
];

const historie = [
  '18.01.2014 – 03.06.2016',
  '03.06.2016 – 02.02.2018',
  '02.02.2018 – 01.02.2019',
  '01.02.2019 – 07.02.2020',
  '07.02.2020 – 01.07.2022',
  '01.07.2022 – 26.01.2024',
  '26.01.2024 – 24.01.2025',
  'ab 24.01.2025 (aktuell)',
];
---

<Layout title="Die Vorstandschaft">
  <h1 class="page-title">Die Vorstandschaft</h1>

  <h2>Aktuelle Vorstandschaft</h2>
  <table>
    <thead>
      <tr><th>Position</th><th>Name</th></tr>
    </thead>
    <tbody>
      {vorstand.map((v) => (
        <tr><td>{v.position}</td><td>{v.name}</td></tr>
      ))}
    </tbody>
  </table>

  <div class="card">
    <h3 style="margin-top:0;">Kontakt 1. Vorstand</h3>
    <p style="margin-bottom:0;">
      Benno Burghart<br />
      Melchior-Huber-Straße 20a<br />
      85652 Pliening<br />
      Handy: <a href="tel:+4915204828829">015204828829</a>
    </p>
  </div>

  <h2>Historie der Vorstandschaften</h2>
  <ul class="plain">
    {historie.map((h) => <li>{h}</li>)}
  </ul>
</Layout>
