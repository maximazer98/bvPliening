  <div class="card">
    <h3 style="margin-top:0;">Ausstattung</h3>
    <ul class="plain">
      <li>4 Damen-WCs</li>
      <li>2 Herren-WCs + 7 Pissoirs</li>
    </ul>
  </div>

  <p class="lead">
    Anfragen und Buchungen bitte telefonisch unter
    <a href="tel:+4915120798191">+49 151 20798191</a>.
  </p>

  <p><a href={`${base}zu-verleihen/`}>&larr; Zurück zu Zu Verleihen</a></p>
</Layout>
