---
import Layout from '../../layouts/Layout.astro';
import PlaceholderImage from '../../components/PlaceholderImage.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="Zu Verleihen">
  <h1 class="page-title">Zu Verleihen</h1>
  <p class="lead">Der Burschenverein Pliening verleiht Klowagen und Festzelt für eure Feier.</p>

  <div class="card-grid">
    <div class="card">
      <div class="card-media">
        <PlaceholderImage />
      </div>
      <h3 style="margin-top:0;"><a href={`${base}zu-verleihen/klowagen/`}>Klowagen</a></h3>
      <p style="margin-bottom:0;">4 Damen-WCs, 2 Herren-WCs + 7 Pissoirs.</p>
    </div>
    <div class="card">
      <div class="card-media">
        <PlaceholderImage />
      </div>
      <h3 style="margin-top:0;"><a href={`${base}zu-verleihen/zelt/`}>Zelt</a></h3>
      <p style="margin-bottom:0;">6 × 12 m, ideal für Feste und Feiern.</p>
    </div>
  </div>
</Layout>
